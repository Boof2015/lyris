      {
        "id": "line_c1f1f97e-a588-41ab-b18e-ae9caedcf767",
        "kind": "lyric",
        "sectionBreakBefore": true,
        "text": "Ah 優雅に罠をすり抜ける 君は変幻自在 Like a wonder",
        "startMs": 73355,
        "endMs": null,
        "voice": null,
        "translations": [
          {

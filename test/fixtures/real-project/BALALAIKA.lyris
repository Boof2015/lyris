        }
      },
      {
        "id": "line_adea85e8-5736-4a27-b910-a301ba12842b",
        "kind": "lyric",
        "sectionBreakBefore": true,
        "text": "Focus 目で追ってしまう 今宵 胸騒ぎなレイトショー",
        "startMs": 15970,
        "endMs": null,
        "voice": null,
        "translations": [
          {
            "id": "translation_7cb159b6-390b-49b1-837d-e56c99a672bb",
            "language": "en",
            "text": "Focus — my eyes just follow you, tonight's a thrilling late show",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.770Z"
            }
          },
          {
            "id": "translation_fc73535a-f968-4bcf-9194-f47328328998",
            "language": "ja-Latn",
            "text": "Focus me de otte shimau koyoi munasawagi na reito shoo",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.770Z"
            }
          }
        ],
        "furigana": [

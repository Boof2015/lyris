      {
        "id": "line_71f961c7-e2c2-42e3-986b-b0397f94e43f",
        "kind": "lyric",
        "sectionBreakBefore": true,
        "text": "戻れないとわかってても崩れてゆく Reason",
        "startMs": 28130,
        "endMs": null,
        "voice": null,
        "translations": [
          {
            "id": "translation_c1a3e696-4aca-4d0b-921e-72880c15d5e5",
            "language": "en",
            "text": "Even knowing I can't go back, my reason crumbles away",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.770Z"
            }
          },
          {
            "id": "translation_fa6eb7df-0567-4948-af9e-a7e5a24ecce8",
            "language": "ja-Latn",
            "text": "modorenai to wakattete mo kuzurete yuku Reason",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.770Z"
            }
          }
        ],
        "furigana": [
          {

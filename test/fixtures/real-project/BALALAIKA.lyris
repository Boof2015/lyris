        "kind": "lyric",
        "sectionBreakBefore": true,
        "text": "恐れないで Gatta get your groove on!",
        "startMs": 154860,
        "endMs": null,
        "voice": null,
        "translations": [
          {
            "id": "translation_2f7aef29-f70e-470d-bebd-c491441711f5",
            "language": "en",
            "text": "Don't be afraid — gotta get your groove on!",

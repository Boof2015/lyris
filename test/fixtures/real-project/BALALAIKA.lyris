      },
      {
        "id": "line_57fb4be3-ad97-446a-b43b-07c922519d7b",
        "kind": "lyric",
        "sectionBreakBefore": true,
        "text": "もうすぐさ フィナーレ",
        "startMs": 138410,
        "endMs": null,
        "voice": null,
        "translations": [
          {
            "id": "translation_c46e58cf-e99c-4302-bd61-c9473e0e8b85",
            "language": "en",
            "text": "The finale is almost here",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.771Z"
            }
          },
          {
            "id": "translation_bc912bb4-c1c5-4cfd-b543-dd632aedde28",
            "language": "ja-Latn",
            "text": "mou sugu sa finaare",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.771Z"
            }
          }
        ],
        "furigana": [],
        "words": [],
        "reviewState": "unreviewed",
        "provenance": {
          "kind": "import",
          "createdAt": "2026-08-12T21:02:18.771Z"
        }
      },
      {
        "id": "line_307fc5a3-910b-43b7-a060-981a6e921a74",
        "kind": "lyric",
        "sectionBreakBefore": true,
        "text": "ジリジリと狼煙上げ 遊糸が惑わせる",
        "startMs": 141330,
        "endMs": null,
        "voice": null,
        "translations": [
          {
            "id": "translation_16c99ef3-5e8f-48ba-9324-fba6e0fdced7",
            "language": "en",
            "text": "Slowly sending up smoke signals, shimmering threads lead astray",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.771Z"
            }
          },
          {
            "id": "translation_d47f1e97-277f-4457-8ad5-4d38f8689c28",
            "language": "ja-Latn",
            "text": "jirijiri to noroshi age yuushi ga madowaseru",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.771Z"
            }
          }
        ],
        "furigana": [

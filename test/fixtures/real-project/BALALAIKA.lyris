      {
        "id": "line_7fefa738-bd6d-4490-93b7-ec0dad750244",
        "kind": "lyric",
        "sectionBreakBefore": true,
        "text": "誰が何言おうが No Way! 心変わりするはずがないんだ",
        "startMs": 49380,
        "endMs": null,
        "voice": null,
        "translations": [
          {
            "id": "translation_3fdf52c4-86ba-428c-a0e1-ef898c3cc3ae",
            "language": "en",
            "text": "No matter what anyone says — no way, there's no chance my heart will change",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.771Z"
            }
          },
          {
            "id": "translation_2eef3240-ab66-4543-b22c-bc0550345760",
            "language": "ja-Latn",
            "text": "dare ga nani iou ga No Way! kokorogawari suru hazu ga nai n da",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.771Z"
            }
          }
        ],

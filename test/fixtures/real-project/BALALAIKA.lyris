        }
      },
      {
        "id": "line_27a7a514-6441-44c2-97f7-08a3c0306957",
        "kind": "lyric",
        "sectionBreakBefore": true,
        "text": "コイセヨ アイセヨ コガレロ お手を拝借",
        "startMs": 30560,
        "endMs": null,
        "voice": null,
        "translations": [
          {
            "id": "translation_42c5d94f-0c18-46b9-8164-96c7d9ce6e5f",
            "language": "en",
            "text": "Fall in love, embrace love, yearn — now lend me your hand",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.771Z"
            }
          },
          {
            "id": "translation_cf4e8b71-322c-41b0-b7d5-5b3e7664b7e6",
            "language": "ja-Latn",
            "text": "koiseyo aiseyo kogarero o-te wo haishaku",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.771Z"
            }
          }
        ],
        "furigana": [
          {
            "start": 16,
            "end": 17,
            "base": "手",
            "reading": "て"
          },
          {
            "start": 18,
            "end": 20,
            "base": "拝借",
            "reading": "はいしゃく"
          }
        ],
        "words": [],
        "reviewState": "unreviewed",
        "provenance": {
          "kind": "import",
          "createdAt": "2026-08-12T21:02:18.771Z"
        }
      },
      {
        "id": "line_eb153591-bea7-4f6e-8601-6dea85bddf35",
        "kind": "lyric",
        "sectionBreakBefore": true,
        "text": "ユラリ揺れる燃ゆる Flame 焦りは禁物さ Balalaika",
        "startMs": 40350,
        "endMs": null,
        "voice": null,
        "translations": [
          {
            "id": "translation_11826211-1aa0-4633-b60f-72756a9d9552",
            "language": "en",
            "text": "The flame sways and burns — no rushing now, Balalaika",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.771Z"
            }
          },
          {
            "id": "translation_e69c8343-bb2c-48cd-94bc-881618586684",
            "language": "ja-Latn",
            "text": "yurari yureru moyuru Flame aseri wa kinmotsu sa Balalaika",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.771Z"
            }
          }
        ],

        }
      },
      {
        "id": "line_63f6511d-a9f3-4309-a5c9-1ef812faef74",
        "kind": "lyric",
        "sectionBreakBefore": true,
        "text": "吠えず闇に潜むケモノ 耳澄まして Listen",
        "startMs": 26060,
        "endMs": null,
        "voice": null,
        "translations": [
          {
            "id": "translation_32eab715-5574-47d6-a72f-826886f964bd",
            "language": "en",
            "text": "A beast lurking silent in the dark — listen close",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.770Z"
            }
          },
          {
            "id": "translation_213ddfbd-d1c6-428d-bdab-fbfbf9f93b8c",
            "language": "ja-Latn",
            "text": "hoezu yami ni hisomu kemono mimi sumashite Listen",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.770Z"
            }
          }
        ],
        "furigana": [

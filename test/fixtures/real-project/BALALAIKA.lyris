        "kind": "lyric",
        "sectionBreakBefore": true,
        "text": "君がいいの Can't stop my heart",
        "startMs": 164650,
        "endMs": null,
        "voice": null,
        "translations": [
          {
            "id": "translation_60782551-c616-4092-8671-c0e00d4205df",
            "language": "en",
            "text": "It's you I want — can't stop my heart",
            "provenance": {

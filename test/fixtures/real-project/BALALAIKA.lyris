        }
      },
      {
        "id": "line_eb69a6a4-f78f-4606-a320-4891e661bb8b",
        "kind": "lyric",
        "sectionBreakBefore": true,
        "text": "白濁に飲まれ I'm crazy for you! Ah",
        "startMs": 145400,
        "endMs": null,
        "voice": null,
        "translations": [
          {
            "id": "translation_d52bde7a-e555-4cf3-b2e3-17c88fb89ce6",
            "language": "en",
            "text": "Swallowed in white haze — I'm crazy for you! Ah",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.771Z"
            }
          },
          {
            "id": "translation_2c85417e-59ea-4908-be7c-fec1afe15e4f",
            "language": "ja-Latn",
            "text": "hakudaku ni nomare I'm crazy for you! Ah",

      {
        "id": "line_fa297a2a-1156-4f09-ba60-b26967619540",
        "kind": "lyric",
        "sectionBreakBefore": true,
        "text": "誰が何言おうが No way! 心変わりするはずがないんだ",
        "startMs": 159820,
        "endMs": null,
        "voice": null,
        "translations": [
          {
            "id": "translation_6070050c-de47-485f-9679-e58458aa5deb",
            "language": "en",
            "text": "No matter what anyone says — no way, there's no chance my heart will change",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.771Z"
            }
          },
          {
            "id": "translation_53f43605-9da5-421d-a15c-876ac4f870ff",
            "language": "ja-Latn",
            "text": "dare ga nani iou ga No way! kokorogawari suru hazu ga nai n da",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.771Z"
            }
          }
        ],

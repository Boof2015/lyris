      {
        "id": "line_251e9f0c-0c92-4498-9923-0291c1c999c2",
        "kind": "lyric",
        "sectionBreakBefore": true,
        "text": "君がいいの Can't stop my heart",
        "startMs": 54320,
        "endMs": null,
        "voice": null,
        "translations": [
          {
            "id": "translation_381c79f8-15dd-48a1-8fc6-c0569295a486",
            "language": "en",
            "text": "It's you I want — can't stop my heart",
            "provenance": {
              "kind": "import",

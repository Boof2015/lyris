      {
        "id": "line_7fc94dfe-74c4-4874-9156-10714ccbd7d0",
        "kind": "lyric",
        "sectionBreakBefore": true,
        "text": "Everybody! Just move your body!",
        "startMs": 136320,
        "endMs": null,
        "voice": null,
        "translations": [],
        "furigana": [],
        "words": [],
        "reviewState": "unreviewed",

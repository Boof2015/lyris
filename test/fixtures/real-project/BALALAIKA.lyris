            "reading": "むねさわ"
          }
        ],
        "words": [],
        "reviewState": "unreviewed",
        "provenance": {
          "kind": "import",
          "createdAt": "2026-08-12T21:02:18.770Z"
        }
      },
      {
        "id": "line_45098d45-3397-45b1-8146-58866179a887",
        "kind": "lyric",
        "sectionBreakBefore": true,
        "text": "カラっとグラス揺らしステアする手で誘う Fallin' Fallin'",
        "startMs": 20970,
        "endMs": null,
        "voice": null,
        "translations": [
          {
            "id": "translation_927fb7be-cec2-4dd5-a0e9-fa55dbd3922a",
            "language": "en",
            "text": "Swirling an empty glass, your stirring hand beckons — Fallin' Fallin'",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.770Z"
            }
          },
          {
            "id": "translation_b73ac595-6b67-4087-943e-0b67e3636ebe",
            "language": "ja-Latn",
            "text": "kara tto gurasu yurashi sutea suru te de sasou Fallin' Fallin'",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.770Z"
            }
          }
        ],
        "furigana": [

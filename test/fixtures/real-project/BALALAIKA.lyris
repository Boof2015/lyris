      {
        "id": "line_f44498c0-08a7-4025-abbe-d1e49efba742",
        "kind": "lyric",
        "sectionBreakBefore": true,
        "text": "どうかしてしまいそうだ 溢れちゃってる君のスパイシー",
        "startMs": 11640,
        "endMs": null,
        "voice": null,
        "translations": [
          {
            "id": "translation_f93bded2-236b-4266-b31f-1a989cce2e10",
            "language": "en",
            "text": "I'm about to lose my mind — you're overflowing with spice",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.770Z"
            }
          },
          {
            "id": "translation_158f8fc8-6156-44fe-b419-662c7234a878",
            "language": "ja-Latn",
            "text": "douka shite shimaisou da afurechatteru kimi no supaishii",
            "provenance": {
              "kind": "import",
              "createdAt": "2026-08-12T21:02:18.770Z"
            }
          }
        ],
        "furigana": [

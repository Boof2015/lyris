        "endMs": null,
        "voice": null,
        "translations": [
          {
            "id": "translation_e4fb2839-cf99-4b05-94f5-b516d2f4ded7",
            "language": "en",
            "text": "Don't be afraid — gotta get your groove on!",
            "provenance": {
